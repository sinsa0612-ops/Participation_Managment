# 환경 설정 예시 — 복사해서 `.env`로 사용 (실제 .env는 git에 올리지 않음).
# 값을 비워두면 app/config.py 의 기본값이 적용된다.

# DB 접속 문자열
# DATABASE_URL=sqlite:///./salary.db

# API 서버 포트 (프론트 vite proxy 대상과 일치해야 함)
# SERVER_PORT=8001

# CORS 허용 출처 (JSON 배열)
# CORS_ORIGINS=["http://localhost:5173"]

# 배분 알고리즘 기준일 (미설정 시 '실제 오늘'). 예: 2026-05-18
# BASE_DATE=2026-05-18
